# Testes de API. Copie para .env (gitignored) e ajuste antes de rodar
# `npx playwright test --project=api`.

API_BASE_URL=https://restful-booker.herokuapp.com
API_AUTH_TOKEN=token-de-exemplo

# Credenciais de login (POST /auth) exigidas pelos steps que alteram uma
# reserva (PATCH /booking/{id}). Valores abaixo são as credenciais públicas
# padrão da API de demonstração restful-booker.
API_AUTH_USERNAME=admin
API_AUTH_PASSWORD=password123
